generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  SUPER_ADMIN
}

enum GameGenre {
  ACTION
  HORROR
  RACING
  PUZZLE_STRATEGY
  SPORTS_FIGHTING
  ARCADE
  RPG
}

model User {
  id           String   @id @default(cuid())
  name         String   @db.VarChar(100)
  username     String   @unique @db.VarChar(30)
  email        String?  @unique @db.VarChar(255)
  phone        String?  @unique @db.VarChar(20)
  gender       String?  @db.VarChar(10)
  dateOfBirth  DateTime? @db.Date
  division     String?  @db.VarChar(30)
  district     String?  @db.VarChar(30)
  passwordHash String   @db.VarChar(255)
  role         UserRole  @default(USER)
  profileImage String?  @db.VarChar(500)
  coverImage   String?  @db.VarChar(500)
  bio          String?  @db.VarChar(500)
  profession  String?  @db.VarChar(100)
  education   String?  @db.VarChar(160)
  currentCity String?  @db.VarChar(120)
  hometown    String?  @db.VarChar(120)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sessions     Session[]
  posts        Post[]
  comments     Comment[]
  pages        Page[]
  pagePosts    PagePost[]
  friendRequestsSent     Friendship[]        @relation("FriendshipRequester")
  friendRequestsReceived Friendship[]        @relation("FriendshipRecipient")
  conversationParticipantOne DirectConversation[] @relation("ConversationParticipantOne")
  conversationParticipantTwo DirectConversation[] @relation("ConversationParticipantTwo")
  directMessagesSent DirectMessage[]         @relation("DirectMessageSender")
  presence          UserPresence?
  notificationsReceived Notification[]       @relation("NotificationRecipient")
  notificationsActed    Notification[]       @relation("NotificationActor")
  groupsCreated         Group[]              @relation("GroupCreator")
  groupMemberships      GroupMembership[]
  groupPosts            GroupPost[]
  listings              Listing[]
  marketplaceListings   MarketplaceListing[]
  mediaProfile          MediaProfile?
  gamesCreated          Game[]

  @@index([username])
  @@index([email])
  @@index([phone])
  @@index([division])
  @@index([district])
  @@map("users")
}

model Game {
  id          String    @id @default(cuid())
  title       String    @db.VarChar(120)
  slug        String    @unique @db.VarChar(140)
  description String    @db.VarChar(1000)
  genre       GameGenre
  thumbnailUrl String   @db.VarChar(500)
  playUrl     String    @db.VarChar(500)
  isFeatured  Boolean   @default(false)
  isActive    Boolean   @default(true)
  rating      Float     @default(0)
  playCount   Int       @default(0)
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([isActive, isFeatured, createdAt])
  @@index([genre, isActive, createdAt])
  @@map("games")
}

model Post {
  id            String   @id @default(cuid())
  content       String   @db.VarChar(500)
  imageUrl      String?  @db.VarChar(500)
  imagePublicId String?  @db.VarChar(255)
  feelingActivity String? @db.VarChar(64)
  youtubeUrl    String?  @db.VarChar(255)
  authorId      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  author        User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments      Comment[]

  @@index([authorId])
  @@index([createdAt])
  @@index([authorId, createdAt])
  @@map("posts")
}

model Comment {
  id        String   @id @default(cuid())
  content   String   @db.VarChar(500)
  postId    String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([authorId])
  @@map("comments")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique @db.VarChar(64)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Page {
  id             String     @id @default(cuid())
  name           String     @db.VarChar(100)
  handle         String     @unique @db.VarChar(30)
  category       String     @db.VarChar(40)
  bio            String?    @db.VarChar(500)
  avatarUrl      String?    @db.VarChar(500)
  avatarPublicId String?    @db.VarChar(255)
  coverUrl       String?    @db.VarChar(500)
  coverPublicId  String?    @db.VarChar(255)
  ownerId        String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  owner          User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  posts          PagePost[]

  @@index([ownerId])
  @@index([handle])
  @@map("pages")
}

model PagePost {
  id            String   @id @default(cuid())
  content       String   @db.VarChar(500)
  imageUrl      String?  @db.VarChar(500)
  imagePublicId String?  @db.VarChar(255)
  pageId        String
  authorId      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  page          Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  author        User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([pageId, createdAt])
  @@index([authorId])
  @@map("page_posts")
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Friendship {
  id          String           @id @default(cuid())
  pairKey     String           @unique @db.VarChar(64)
  requesterId String
  recipientId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient   User             @relation("FriendshipRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([requesterId, status])
  @@index([recipientId, status])
  @@map("friendships")
}

model DirectConversation {
  id               String          @id @default(cuid())
  pairKey          String          @unique @db.VarChar(64)
  participantOneId String
  participantTwoId String
  marketplaceMessagingEnabled Boolean @default(false)
  lastMessageAt    DateTime        @default(now())
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  participantOne   User            @relation("ConversationParticipantOne", fields: [participantOneId], references: [id], onDelete: Cascade)
  participantTwo   User            @relation("ConversationParticipantTwo", fields: [participantTwoId], references: [id], onDelete: Cascade)
  messages         DirectMessage[]

  @@index([participantOneId, lastMessageAt])
  @@index([participantTwoId, lastMessageAt])
  @@map("direct_conversations")
}

model DirectMessage {
  id             String             @id @default(cuid())
  content        String             @db.VarChar(1000)
  attachments    String[]
  isRead         Boolean            @default(false)
  conversationId String
  senderId       String
  marketplaceListingId String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  conversation   DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User               @relation("DirectMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  marketplaceListing MarketplaceListing? @relation("MarketplaceListingMessages", fields: [marketplaceListingId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("direct_messages")
}

model UserPresence {
  userId       String   @id
  isOnline     Boolean  @default(false)
  lastActiveAt DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isOnline])
  @@map("user_presence")
}

enum NotificationType {
  FRIEND_REQUEST
  FRIEND_ACCEPT
  MESSAGE
}

model Notification {
  id          String           @id @default(cuid())
  type        NotificationType
  recipientId String
  actorId     String
  entityId    String?          @db.VarChar(40)
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())
  recipient   User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor       User             @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([recipientId, isRead, createdAt])
  @@index([recipientId, createdAt])
  @@map("notifications")
}

model Ad {
  id             String   @id @default(cuid())
  title          String   @db.VarChar(120)
  description    String?  @db.VarChar(280)
  imageUrl       String   @db.VarChar(500)
  imagePublicId  String?  @db.VarChar(255)
  destinationUrl String   @db.VarChar(500)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isActive, createdAt])
  @@map("ads")
}

enum GroupPrivacy {
  PUBLIC
  PRIVATE
}

enum GroupPostingPolicy {
  MEMBERS
  ADMINS_ONLY
}

enum GroupRole {
  ADMIN
  MODERATOR
  MEMBER
}

enum GroupMembershipStatus {
  PENDING
  APPROVED
  REJECTED
}

model Group {
  id            String             @id @default(cuid())
  name          String             @db.VarChar(80)
  handle        String             @unique @db.VarChar(60)
  description   String?            @db.VarChar(500)
  privacy       GroupPrivacy
  postingPolicy GroupPostingPolicy
  coverImage    String?            @db.VarChar(500)
  creatorId     String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  creator       User               @relation("GroupCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  memberships   GroupMembership[]
  posts         GroupPost[]

  @@index([creatorId])
  @@index([privacy, createdAt])
  @@map("groups")
}

model GroupMembership {
  id        String                @id @default(cuid())
  groupId   String
  userId    String
  role      GroupRole             @default(MEMBER)
  status    GroupMembershipStatus @default(PENDING)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  group     Group                 @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId, status, createdAt])
  @@index([userId, status, createdAt])
  @@map("group_memberships")
}

model GroupPost {
  id            String   @id @default(cuid())
  content       String   @db.VarChar(500)
  imageUrl      String?  @db.VarChar(500)
  imagePublicId String?  @db.VarChar(255)
  feelingActivity String? @db.VarChar(64)
  youtubeUrl    String?  @db.VarChar(255)
  groupId       String
  authorId      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  group         Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author        User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
  @@index([authorId])
  @@map("group_posts")
}

enum ListingCondition {
  NEW
  USED_LIKE_NEW
  USED_GOOD
  USED_FAIR
}

enum ListingStatus {
  AVAILABLE
  SOLD
}

enum MarketplaceCategory {
  ELECTRONICS
  VEHICLES
  PROPERTY
  FURNITURE
  FASHION
  HOBBIES
  OTHER
  STORY_WRITER
  DIRECTOR
  ARTIST
  PRODUCER
  DOP
  CAMERA_HOUSE
  SHOOTING_HOUSE
  MAKEUP_MAN
  PRODUCTION
  SHOOTING_BUS_CAR
  LIGHT_HOUSE
}

enum MarketplaceCondition {
  NEW
  USED
}

enum MarketplaceStatus {
  AVAILABLE
  SOLD_OUT
}

enum MediaProfileStatus {
  PENDING
  APPROVED
  REJECTED
}

model MediaProfile {
  id          String             @id @default(cuid())
  userId      String             @unique
  fullName    String             @db.VarChar(100)
  profession  MarketplaceCategory
  bio         String             @db.VarChar(500)
  photoUrl    String?            @db.VarChar(500)
  division    String             @db.VarChar(30)
  district    String             @db.VarChar(30)
  phone       String?            @db.VarChar(20)
  email       String?            @db.VarChar(255)
  portfolio   String?            @db.VarChar(2000)
  experience  String?            @db.VarChar(200)
  status      MediaProfileStatus @default(PENDING)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([profession, status])
  @@index([division, district, status])
  @@map("media_profiles")
}

model MarketplaceListing {
  id          String               @id @default(cuid())
  sellerId    String
  title       String               @db.VarChar(120)
  description String               @db.VarChar(2000)
  pricePaisa  Int
  category    MarketplaceCategory
  condition   MarketplaceCondition
  location    String               @db.VarChar(120)
  status      MarketplaceStatus    @default(AVAILABLE)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  seller      User                 @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  images      MarketplaceImage[]
  messages    DirectMessage[]      @relation("MarketplaceListingMessages")

  @@index([sellerId, updatedAt])
  @@index([status, createdAt])
  @@index([category, status, createdAt])
  @@map("marketplace_listings")
}

model MarketplaceImage {
  id        String              @id @default(cuid())
  listingId String
  url       String              @db.VarChar(500)
  publicId  String              @db.VarChar(255)
  position  Int
  listing   MarketplaceListing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, position])
  @@map("marketplace_images")
}

model Listing {
  id            String           @id @default(cuid())
  title         String           @db.VarChar(120)
  price         Int
  description   String?          @db.VarChar(1000)
  category      String           @db.VarChar(40)
  condition     ListingCondition
  status        ListingStatus    @default(AVAILABLE)
  location      String?          @db.VarChar(120)
  imageUrl      String?          @db.VarChar(500)
  imagePublicId String?          @db.VarChar(255)
  sellerId      String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  seller        User             @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([sellerId])
  @@index([category, status, createdAt])
  @@map("listings")
}
